# Template for docker compose. Do NOT put real values in this file.
# Run `make env` (scripts/gen-env.sh) to create .env with fresh random
# secrets; .env is git-ignored. Every value below is deliberately empty, and
# compose refuses to start while any of them is.

# PostgreSQL password for the oms role (hex or other URL-safe characters).
POSTGRES_PASSWORD=

# Shared between omsd and the simulated broker.
OMS_BROKER_API_KEY=
OMS_BROKER_WEBHOOK_SECRET=

# API principals as one line of JSON; see examples/api-keys.example.json.
# Tokens must be at least 24 characters.
OMS_API_KEYS=

# Used only by scripts/api-walkthrough.sh; must match the tokens above.
OMS_URL=http://127.0.0.1:8080
BROKER_URL=http://127.0.0.1:9090
TRADER_TOKEN=
VIEWER_TOKEN=
OPERATOR_TOKEN=
